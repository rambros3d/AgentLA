; ==========================================================================
; RVSWD PIO Program (AgentLA)
;
; Vendored from RVSWD_pico (https://github.com/Nicolai-Electronics/RVSWD_pico)
; WCH 2-wire RISC-V debug protocol (QingKe V4 / CH32V20x, CH32V30x).
; License: MIT
;
; Wire protocol:
;   START  : SWDIO=H,CLK=H -> SWDIO=L,CLK=H
;   HEADER : 9 bits [7-bit reg][1-bit op][1-bit parity] (even parity over reg+op)
;   TRN    : 5 bits 0b10101 (host driven)
;   WRITE  : 32-bit data + 1 even-parity bit
;   READ   : 32-bit data (target) + 1 parity bit
;   TRAILER: 5 bits 0b10111 (host driven)
;   STOP   : SWDIO=L,CLK=H -> SWDIO=H,CLK=H -> release SWDIO
;   RESET  : SWDIO=H for N CLK cycles, then STOP
; ==========================================================================

.program rvswd_io
.side_set 1 opt

.define public BIT_DELAY 2

; --- Command Dispatcher (Entry Point) ---
.wrap_target
public get_next_cmd:
    pull                side 1 ; Pull command, CLK idle high
    out x, 8            ; Get bit count (X = count-1)
    out pindirs, 1      ; Get direction (1=write, 0=read)
    out pc, 5           ; Jump to command address

; --- Write Bits (Push Pull) ---
public write_bits:
    pull
write_bitloop:
    out pins, 1  side 0 [BIT_DELAY] ; CLK=0. Send data
    nop             side 1 [BIT_DELAY] ; CLK=1. Hold.
    jmp x-- write_bitloop
    jmp get_next_cmd

; --- Read Bits ---
read_bitloop_entry:
    nop side 1
public read_bits:
    nop  side 0 [BIT_DELAY]
    in pins, 1      side 1 [BIT_DELAY]
    jmp x-- read_bits
    push
    jmp get_next_cmd

; --- Special Sequences ---
public start:
    set pindirs, 1                  ; Drive SWDIO
    set pins, 1  side 1 [BIT_DELAY] ; SWDIO=H, CLK=H
    set pins, 0  side 1 [BIT_DELAY] ; SWDIO=L, CLK=H
    jmp get_next_cmd

public stop:
    set pins, 0  side 1 [BIT_DELAY] ; SWDIO=L, CLK=H
    set pins, 1  side 1 [BIT_DELAY] ; SWDIO=H, CLK=H
    set pindirs, 0                  ; Release SWDIO
    jmp get_next_cmd

public reset:
    set pindirs, 1                  ; Drive SWDIO
    set pins, 1  side 1 [BIT_DELAY] ; SWDIO=H
reset_loop:
    nop             side 0 [BIT_DELAY]
    nop             side 1 [BIT_DELAY]
    jmp x-- reset_loop
    jmp stop            ; Jump to stop sequence
.wrap
