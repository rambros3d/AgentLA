; ==========================================================================
; SWD PIO Program (v2 - MioLink modular architecture)
;
; Based on MioLink's pio_swd_miolink_pico.pio, adapted for RP2350 PIO0.
;
; Pin mapping (RP2350 PIO0):
;   SWCLK = GPIO 4  (side-set pin 0)
;   SWDIO = GPIO 5  (IN/OUT/Set pin)
; NOTE: On RP2350, PIO1 only covers GPIO16-47. SWD pins GPIO4/5
; are in PIO0's range (GPIO0-31), so PIO0 must be used for SWD.
;
; Architecture: 7 modular sub-programs with .origin directives.
; Each SWD operation is a separate PIO program at a fixed address.
; C code dispatches by pushing origin addresses to TX FIFO (out pc, 32).
;
; Max frequency: sys_clk / 8 = 15.625 MHz (at 125 MHz sys_clk)
; Default: 100 kHz (divider = clk_sys / 800000) — safe for STM32F1 SWJ-DP
; line-reset / JTAG-to-SWD switching; swd_set_clock() overrides per command.
;
; Autopull: ON, threshold 32 bits
; Autopush: ON, threshold 32 bits
; ==========================================================================

; Program 0: start (origin 0)
; Pull first command origin from TX FIFO, then dispatch via out pc.
.program swd_start
.pio_version 0
.origin 0
.side_set 1 opt

pull block side 0 [0]                       ; pull first origin from TX FIFO into OSR
out pc, 32                                  ; jump to sub-program


; Program 1: seq_out_turnaround (origin 2)
.program swd_seq_out_turnaround
.pio_version 0
.origin 2
.side_set 1 opt

set pindirs, 1 side 0 [3]                   ; SWDIO = output, SWCLK stays LOW (turnaround low phase)
nop side 0 [3]                              ; hold SWCLK LOW — no extra clock period, so the first
                                            ; data bit is sampled by the target on the next rising
                                            ; edge (matches the bitbanging reference driver)


; Program 2: seq_out (origin 4)
.program swd_seq_out
.pio_version 0
.origin 4
.side_set 1 opt

out x, 32                                   ; load bit count - 1 from TX FIFO
swd_seq_out_loop:
    out pins, 1 side 0 [3]                  ; output bit on SWDIO, SWCLK low
    jmp x-- swd_seq_out_loop side 1 [3]     ; next bit, SWCLK high

mov osr, null                               ; clear OSR remaining bits so pull block gets next origin
pull block side 0 [2]                       ; reload OSR, SWCLK low
out pc, 32                                  ; wait for next command origin


; Program 3: seq_in_turnaround (origin 10)
.program swd_seq_in_turnaround
.pio_version 0
.origin 10
.side_set 1 opt

set pindirs, 0 side 0 [3]                   ; SWDIO = input (release), SWCLK stays LOW
nop side 0 [3]                              ; hold SWCLK LOW — no extra clock period: ACK is
                                            ; sampled on the very next rising edge, exactly like
                                            ; the bitbanging reference driver. The second
                                            ; instruction also keeps the 2-instruction sub-program
                                            ; size so the SM falls through to seq_in at origin 12.


; Program 4: seq_in (origin 12)
.program swd_seq_in
.pio_version 0
.origin 12
.side_set 1 opt

out x, 32 side 0 [0]                        ; load bit count from TX FIFO
mov isr, null side 0 [0]                    ; clear ISR before shifting in new bits
swd_seq_in_loop:
    nop side 1 [3]                          ; SWCLK HIGH — this rising edge starts bit N's clock.
                                            ; The STM32F1 target updates SWDIO exactly at the
                                            ; rising edge, so we must NOT sample on it directly.
    in pins, 1 side 0 [2]                   ; sample SWDIO in the middle of the HIGH phase, then
                                            ; SWCLK LOW. The PIO input sync (~2-3 cycles) shifts
                                            ; the read back into the stable region — matching the
                                            ; bitbanging reference, which samples after the edge.
    jmp x-- swd_seq_in_loop                 ; next bit (8 cycles/bit: 4 high + 4 low)

mov x, isr side 0 [1]                       ; save ISR content to X register for ACK check
push                                        ; push ISR to RX FIFO
out pc, 32                                  ; wait for next command origin


; Program 5: adiv5_check_ack (origin 20)
; NOTE: .origin MUST equal the load offset used by tap_pio.c (SWD_ORIGIN_CHECK_ACK=20),
; otherwise pio_add_program_at_offset() rejects the program (PICO_ERROR_BAD_ALIGNMENT)
; and the SM would execute garbage (jmp self-loop) at address 20.
.program swd_adiv5_check_ack
.pio_version 0
.origin 20
.side_set 1 opt

out y, 32                                   ; load expected ACK into Y register
jmp x!=y clear_tx_fifo                      ; if ACK mismatch, go clear TX FIFO
out null, 32                                ; if ACK matches, discard count to clear
out pc, 32                                  ; wait for next command origin

clear_tx_fifo:
    out x, 32                               ; load number of words to discard
clear_tx_fifo_loop:
    out null, 32                            ; discard word from TX FIFO
    jmp x-- clear_tx_fifo_loop              ; loop until cleared


; Program 6: turnaround_float_to_drive (origin 27)
; Placed directly after check_ack (20-26) so the clear_tx_fifo loop can fall
; through into it (MioLink design). Must match the load offset in tap_pio.c.
.program swd_turnaround_float_to_drive
.pio_version 0
.origin 27
.side_set 1 opt

set pindirs, 1 side 1 [3]                   ; SWDIO = output, SWCLK high
out pc, 32 side 0 [3]                       ; SWCLK low, wait for next command origin


; ==========================================================================
; C SDK Helper Functions
; ==========================================================================

% c-sdk {

#include "pico/stdlib.h"
#include "hardware/pio.h"
#include "hardware/clocks.h"

/* SWD pin definitions */
#define SWD_SWCLK_PIN  4   /* PIO0 SWCLK (side-set pin 0) */
#define SWD_SWDIO_PIN  5   /* PIO0 SWDIO (IN/OUT/Set pin) */

/* PIO sub-program origin addresses */
#define SWD_ORIGIN_START                   0
#define SWD_ORIGIN_SEQ_OUT_TURNAROUND      2
#define SWD_ORIGIN_SEQ_OUT                 4
#define SWD_ORIGIN_SEQ_IN_TURNAROUND      10
#define SWD_ORIGIN_SEQ_IN                  12
#define SWD_ORIGIN_CHECK_ACK              20
#define SWD_ORIGIN_TURNAROUND_TO_DRIVE    27

static inline void swd_gpio_init(void)
{
    pio_gpio_init(pio0, SWD_SWCLK_PIN);
    pio_sm_set_consecutive_pindirs(pio0, 0, SWD_SWCLK_PIN, 1, true);
    gpio_set_drive_strength(SWD_SWCLK_PIN, GPIO_DRIVE_STRENGTH_12MA);
    gpio_set_slew_rate(SWD_SWCLK_PIN, GPIO_SLEW_RATE_FAST);

    pio_gpio_init(pio0, SWD_SWDIO_PIN);
    pio_sm_set_consecutive_pindirs(pio0, 0, SWD_SWDIO_PIN, 1, false);
    gpio_pull_up(SWD_SWDIO_PIN);
    gpio_set_drive_strength(SWD_SWDIO_PIN, GPIO_DRIVE_STRENGTH_12MA);
    gpio_set_slew_rate(SWD_SWDIO_PIN, GPIO_SLEW_RATE_FAST);
}

static inline void swd_sm_init(pio_sm_config *sm_config)
{
    sm_config_set_sideset_pins(sm_config, SWD_SWCLK_PIN);
    sm_config_set_out_pins(sm_config, SWD_SWDIO_PIN, 1);
    sm_config_set_set_pins(sm_config, SWD_SWDIO_PIN, 1);
    sm_config_set_in_pins(sm_config, SWD_SWDIO_PIN);
    sm_config_set_out_shift(sm_config, true, true, 32);
    sm_config_set_in_shift(sm_config, true, true, 32);

    /* Default SWD interface clock: 100 kHz (safe for STM32F1 SWJ-DP
     * line-reset and JTAG-to-SWD switching). Each SWD bit period is 8 SM
     * cycles (4-cycle instructions + [3] delay slots), so the clock divider
     * is clk_sys / (8 * 100000). swd_set_clock() may override this later. */
    sm_config_set_clkdiv(sm_config, (float)clock_get_hz(clk_sys) / (8.0f * 100000.0f));
}

static inline void swd_gpio_deinit(void)
{
    pio_sm_set_enabled(pio0, 0, false);
    gpio_deinit(SWD_SWCLK_PIN);
    gpio_disable_pulls(SWD_SWCLK_PIN);

    gpio_deinit(SWD_SWDIO_PIN);
    gpio_disable_pulls(SWD_SWDIO_PIN);
}

%}
