; ==========================================================================
; WCH 1-Wire SDI PIO Program (RP2350 PIO)
;
; Single-Wire Debug Interface (SDI) for WCH CH32V003 (QingKe V2A)
; Pin mapping:
;   SWDIO = GPIO 5 (IN/OUT/Set pin)
;
; Timing: Bit cell period T ~ 1.0 us at 125 MHz clock with clock divider.
; ==========================================================================

.program wch_sdi
.pio_version 0

; Reset sequence: Drive SWDIO low for ~15 us, then release high for ~5 us
.wrap_target
public reset:
    set pindirs, 1      ; SWDIO = output
    set pins, 0 [31]    ; SWDIO low
    set pins, 0 [31]    ; extra delay for reset low
    set pins, 1 [15]    ; SWDIO high delay
    set pindirs, 0      ; SWDIO = input
    jmp reset

public tx_bit:
    ; Transmit 1 bit from OSR
    ; 0 bit: Low for 3/4 cell, High for 1/4 cell
    ; 1 bit: Low for 1/4 cell, High for 3/4 cell
    out x, 1
    set pindirs, 1
    set pins, 0
    jmp !x bit_zero
bit_one:
    nop [3]             ; short low pulse
    set pins, 1 [12]    ; long high pulse
    jmp finish_bit
bit_zero:
    nop [12]            ; long low pulse
    set pins, 1 [3]     ; short high pulse
finish_bit:
    set pindirs, 0
    .wrap

.program wch_sdi_raw
.pio_version 0

; Send N bits from OSR to SWDIO
public tx_stream:
    set pindirs, 1
tx_loop:
    out pins, 1 [2]     ; drive bit value
    jmp !osre tx_loop
    set pindirs, 0

; Read N bits from SWDIO into ISR
public rx_stream:
    set pindirs, 0
rx_loop:
    in pins, 1 [2]      ; sample bit value
    jmp !x rx_loop
