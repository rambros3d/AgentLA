; ==========================================================================
; Loopback Test PIO Program
;
; PIO wire-level loopback test for verifying SWD DMA path.
; Requires jumper between GPIO4 (SWCLK) and GPIO5 (SWDIO).
;
; Pin mapping:
;   GPIO4 = SWCLK (out, side-set)
;   GPIO5 = SWDIO (in)
;
; Protocol: TX FIFO sends [bit_count-1], then [data]. PIO loops bit_count
; times, outputting data bits on SWCLK and sampling SWDIO. Result pushed
; to RX FIFO after the loop completes.
; ==========================================================================

.program loopback_test
.pio_version 0
.side_set 1 opt

; Pull loop count from TX FIFO into X register
out x, 32                                ; load bit count - 1 from TX FIFO

; Pull data word from TX FIFO (will be shifted out via autopull)
; We don't explicitly pull - autopull with threshold 32 handles it

; Main loop: output 1 bit to SWCLK (side-set), read 1 bit from SWDIO
loopback_loop:
    out pins, 1 side 0 [1]              ; SWCLK low, output next bit
    in pins, 1 side 1 [1]               ; SWCLK high, sample SWDIO
    jmp x-- loopback_loop               ; decrement counter, loop

; Push accumulated 32-bit result to RX FIFO
push                                    ; push ISR (32-bit sampled data) to RX FIFO
out pc, 32                              ; wait for next command origin
