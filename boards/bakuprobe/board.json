{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "board_id": "bakuprobe",
  "name": "BakuProbe",
  "vendor": "AgentLA",
  "version": "1.0.0",
  "assets": {
    "logo": "logo.svg",
    "favicon": "favicon.svg",
    "pinout": "pinout.svg"
  },
  "network": {
    "ip": "10.10.10.10",
    "netmask": "255.255.255.0",
    "domain": "agentla.local"
  },
  "mcu": {
    "chip": "RP2350B",
    "package": "QFN-80",
    "cores": "Dual ARM Cortex-M33 / Hazard3 RISC-V",
    "clock_max_mhz": 150,
    "sram_bytes": 532480,
    "flash_bytes": 16777216,
    "flash_chip": "Winbond W25Q128JW (16MB, 1.8V SPI NOR on QSPI_IOVDD)"
  },
  "gpio_range": [0, 47],
  "spare_gpios": [7, 23, 24, 25],
  "emergency_button": {
    "pin": 5,
    "active_state": "LOW",
    "function": "Hardware Emergency Stop / Safe Mode profile trip"
  },
  "header_neopixels": {
    "pin": 6,
    "protocol": "WS2812B / SK6805 (800 kHz PIO0 DMA)",
    "led_package": "1515 SMD (1.5mm x 1.5mm)",
    "count": 40,
    "features": "Individual color-coded role, voltage, logic activity, and fault display for every header pin"
  },
  "features": {
    "onboard_led": null,
    "vref_volts": 3.0,
    "vref_precision_ic": "TI REF3030AIDBZT (3.000V +/-0.2%, 35ppm/C)",
    "has_hardware_can": true,
    "has_hardware_rs485": true,
    "has_i2c_adapter": true,
    "has_socketcan": true,
    "target_current_sense": true,
    "target_power_control": true,
    "qwiic_stemma_qt": true
  },
  "power_architecture": {
    "usb_c": {
      "standard": "USB 2.0 Full-Speed Type-C (5V VBUS up to 1.5A/3A)",
      "protection": "UMW USBLC6-2SC6 high-speed ESD + resettable PTC polyfuse"
    },
    "dc_barrel_jack": {
      "enabled": true,
      "connector": "5.5mm x 2.1mm / 2.5mm Center-Positive",
      "voltage_range": "0.0V - 24.0V",
      "max_current_a": 20.0,
      "pwm_switch": "High-Efficiency N-FET + TI LM5106 gate driver (GP1 / DC24V_PWM, up to 20 kHz)",
      "inductive_clamp": "V10150 / SS54 Schottky flyback diode + TVS suppressor",
      "current_sense": "TI INA240A1 across 2mOhm shunt -> ADS1118 Ch 3",
      "voltage_sense": "Precision resistor divider -> ADS1118 Ch 2"
    },
    "regulators": {
      "digital_3v3_ldo": "MKSemi AMS1117-3.3V (SOT-89)",
      "digital_1v8_ldo": "MKSemi AMS1117-1.8V (SOT-89)",
      "analog_filter": "Ferrite Bead BLM18PG121 + 100nF + 2.2uF passive LC",
      "vref_precision_ic": "TI REF3030AIDBZT (3.000V +/-0.2%, 35ppm/C)"
    },
    "target_power": {
      "voltage_selection": "Manual 3-way switch (1.8V, 3.3V, 5.0V)",
      "voltage_auto_detect": "10:1 resistor divider -> ADS1118 Ch 0",
      "current_sense_ic": "TI INA180A2 (G=50) -> ADS1118 Ch 1",
      "high_side_switch": "P-FET controlled by Shift Reg Bit 24 (TARGET_PWR_EN)",
      "current_sensing": {
        "architecture": "PPK2-Style Dynamic Auto-Bypass (1uA to 500mA)",
        "shunts": "0.05 Ohm (Active) in series with 10 Ohm (Sleep)",
        "auto_bypass_fet": "SI2301 / DMP3099 P-FET",
        "fast_comparator": "TI TLV3691 / SGM8743 (<50ns) -> GP0 (TARGET_RANGE_FLAG)",
        "brownout_clamp": "BAT54 sub-nanosecond Schottky diode",
        "amplifier": "TI INA180A2 (G=50) -> ADS1118 Ch 1"
      }
    }
  },
  "internal_instrumentation": {
    "power_adc": {
      "chip": "TI ADS1118IRUGR",
      "interface": "Dedicated SPI0 (SCK=GP10, MOSI=GP11, MISO=GP8, CS=GP9)",
      "channels": {
        "ch0": "Target Rail Voltage (10:1 divider)",
        "ch1": "Target Current Draw (TI INA180)",
        "ch2": "24V Aux DC Voltage (divider)",
        "ch3": "24V Aux DC Current Draw (TI INA240 20A shunt)"
      }
    },
    "shift_registers": {
      "chip": "4x 74HC595 / 74LVC595 cascaded (32 bits total)",
      "interface": "Dedicated PIO0 Bus (Clock GP3, Data GP4, Latch GP2)",
      "shift_time_us": 1.28,
      "byte1_mso_gain_low": "Bits 0..7 (MSO Ch 0..3 2-bit gain selectors)",
      "byte2_mso_gain_high": "Bits 8..15 (MSO Ch 4..7 2-bit gain selectors)",
      "byte3_la_dir": "Bits 16..23 (Pod 4 LA_DIR[0..7] per-channel direction: 0=In, 1=Out)",
      "byte4_system_enables": "Bits 24..31 (TARGET_PWR_EN, PROG_OE, BUS_OE, CAN_TERM, CAN_STBY, RS485_DE, BOOT0, nTRST)"
    }
  },
  "pio_partitioning": {
    "pio0": {
